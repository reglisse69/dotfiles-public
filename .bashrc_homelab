alias cpv='rsync -Pav'
if [ -d /tools ]; then
  alias cdt='cd /tools'
fi

[ -d /tools ] && alias cdt='cd /tools'

[ -d /etc/docker ] && alias cdd='cd /etc/docker'

# ---------------------------------------------------------------------------
# FUNCTIONS
# ---------------------------------------------------------------------------

if [[ -n "$IS_WSL" || -n "$WSL_DISTRO_NAME" ]]; then
  if [[ ! -f ~/.mainsource.yadmpush ]]; then
    timestamp=~/.timestamp.yadmpull
    if [ -f $timestamp ]; then
        file_timestamp=$(stat -c %Y $timestamp)
        if [ $((current_timestamp - file_timestamp)) -gt 86400 ]; then
            /tools/shell/yadm_pull.sh
            touch $timestamp
        fi
    else
        /tools/shell/yadm_pull.sh
        touch $timestamp
    fi
  fi
fi

# ---------------------------------- include .zshrc specific to host or user if exist -------------------------------- #
SHELLRC=".${SHELL##*/}rc"
for PROFILE in ${HOME}/${SHELLRC}_secrets ${HOME}/${SHELLRC}_`hostname` ${HOME}/${SHELLRC}_`hostname`.$USER ${HOME}/${SHELLRC}_$USER ${HOME}/.secrets; do
  if [[ -f "$PROFILE" ]]; then
    PROFILE_NAME=$(basename "$PROFILE")
    PROFILE_NAME=${PROFILE_NAME/bashrc/}
    PROFILE_NAME=${PROFILE_NAME#.}    
    PROFILE_NAME=${PROFILE_NAME#_} 
    PROFILE_NAME=${PROFILE_NAME/xxx/videos}
    PROFILE_NAME=${PROFILE_NAME/wsl-integ/wsl}
    PROFILE_NAME=${PROFILE_NAME/secrets/🔑}
    echo "🔄 Loading `basename $PROFILE_NAME`"
    source "$PROFILE"
  fi
done

